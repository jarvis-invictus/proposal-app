# Environment variables required to run Marg.
# Copy this file to .env.local for local dev, and set the same names in the Vercel project's
# Environment Variables settings for production. Values below are dummy placeholders — replace
# every one with the real value from the corresponding dashboard.
#
# Everything under "Not yet integrated" documents what production will eventually need, per
# docs/MVP_LAUNCH_PLAN.md, even though no code reads those vars yet — so this file stays the
# single checklist for configuring Vercel instead of two different lists living in two places.

# ---------------------------------------------------------------------------
# Supabase — database, auth, storage. Required.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=REPLACE_WITH_YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_YOUR_SUPABASE_ANON_KEY
# Server-only — never expose to the client. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# OpenAI — proposal generation (generateObject) and the intake chat (streamText). Required.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# ---------------------------------------------------------------------------
# Browserless — headless Chrome, used for server-rendered PDF/print output. Required.
# ---------------------------------------------------------------------------
BROWSERLESS_API_KEY=REPLACE_WITH_YOUR_BROWSERLESS_API_KEY

# ---------------------------------------------------------------------------
# Upstash Redis — rate limiting on the AI endpoints (/api/generate-proposal, /api/chat).
# Free tier is enough at current scale. If these are unset, rate limiting is bypassed and a
# warning is logged in development — the app still runs, this is not a hard requirement locally.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=REPLACE_WITH_YOUR_UPSTASH_REDIS_REST_TOKEN

# ---------------------------------------------------------------------------
# Sentry — error tracking. Free tier is enough at current scale. If NEXT_PUBLIC_SENTRY_DSN is
# unset, Sentry is disabled entirely (client, server, and edge) and the build/app run normally.
# SENTRY_ORG/PROJECT/AUTH_TOKEN are only needed for uploading source maps at build time — safe
# to leave unset locally.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=REPLACE_WITH_YOUR_SENTRY_DSN
SENTRY_ORG=REPLACE_WITH_YOUR_SENTRY_ORG_SLUG
SENTRY_PROJECT=REPLACE_WITH_YOUR_SENTRY_PROJECT_SLUG
SENTRY_AUTH_TOKEN=REPLACE_WITH_YOUR_SENTRY_AUTH_TOKEN

# ---------------------------------------------------------------------------
# Payments — not yet integrated in code. Documented here as the checklist for §3.1 of
# docs/MVP_LAUNCH_PLAN.md, so this file names everything production will need before that work
# starts, not just what's already wired up.
#
# Stripe — Marg's own subscription billing (§3.1a). Global-first/USD per the launch plan;
# Razorpay was the earlier, now-superseded decision.
# (test-mode secret key, webhook signing secret, publishable key — from the Stripe dashboard)
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY
#
# Skydo — cross-border payment receipt for Marg's own (India-based) users getting paid by
# international clients (§3.1b, explicitly post-MVP). Not a Stripe alternative — a different
# job (see §3.1's writeup for why the two aren't interchangeable).
SKYDO_API_KEY=REPLACE_WITH_YOUR_SKYDO_API_KEY
